{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "plugins": ["html"],
  "parserOptions": {
    "ecmaVersion": 13,
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["api/**/*.js", "lib/**/*.js", "test/**/*.js", "scripts/**/*.js"],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      }
    }
  ],
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-redeclare": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error"
  }
}
