{
  "name": "brightkey-website",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-chromium-pack.js",
    "build": "node scripts/build-products.js",
    "lint": "eslint \"dashboard/**/*.html\" \"dashboard/**/*.js\" \"*.html\" \"js/**/*.js\" && npm run check:module-size",
    "check:module-size": "node scripts/check-js-module-size.js",
    "test:storage": "node --test test/storage-quota.test.js",
    "preflight": "npm run check:module-size && node --test test/security.test.js test/storage-quota.test.js test/public-pricing.test.js && node scripts/preflight-dashboard.js",
    "preflight:live": "npm run check:module-size && node --test test/security.test.js test/storage-quota.test.js test/public-pricing.test.js && node scripts/preflight-dashboard.js --require-live",
    "test:messenger": "node --test test/messenger/*.test.js",
    "test:security": "node --test test/security.test.js"
  },
  "dependencies": {
    "@sparticuz/chromium-min": "^149.0.0",
    "@supabase/supabase-js": "^2.43.0",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "nodemailer": "9.0.5",
    "puppeteer-core": "^25.6.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.1"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
