{
  "name": "brightkey-website",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-products.js",
    "lint": "eslint \"dashboard/**/*.html\" \"dashboard/**/*.js\" \"*.html\" \"js/**/*.js\" && npm run check:module-size",
    "check:module-size": "node scripts/check-js-module-size.js",
    "test:storage": "node --test test/storage-quota.test.js",
    "preflight": "npm run check:module-size && node --test test/security.test.js test/storage-quota.test.js && node scripts/preflight-dashboard.js",
    "preflight:live": "npm run check:module-size && node --test test/security.test.js test/storage-quota.test.js && node scripts/preflight-dashboard.js --require-live",
    "test:messenger": "node --test test/messenger/*.test.js",
    "test:security": "node --test test/security.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.1"
  }
}
