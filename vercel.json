{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/career-page.js": {
      "includeFiles": "careers/job-template.html"
    },
    "api/hr-contract-pdf.js": {
      "includeFiles": "dashboard/{hiring/contract-template.css,hr-onboarding/hr-onboarding.css}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/smartlock-calendar",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/js/smartlock-calendar/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    { "source": "/dashboard/warehouse/inspect", "destination": "/dashboard/warehouse/pack", "permanent": true },
    { "source": "/dashboard/warehouse/requests", "destination": "/dashboard/warehouse/pack", "permanent": true },
    { "source": "/dashboard/hr-onboarding/handbook", "destination": "/dashboard/hr-onboarding/materials", "permanent": true },
    { "source": "/hiring/job-post/:code", "destination": "/careers/:code", "permanent": true },
    { "source": "/dashboard/booking-schedules", "destination": "/dashboard/booking-schedules/calendar", "permanent": true },
    { "source": "/dashboard/booking-schedules/installers", "destination": "/dashboard/installers/assignments", "permanent": true },
    { "source": "/dashboard/installers", "destination": "/dashboard/installers/assignments", "permanent": true },
    { "source": "/dashboard/inventory", "destination": "/dashboard/inventory/summary", "permanent": true },
    { "source": "/dashboard/team/management", "destination": "/dashboard/business/directions/planning", "permanent": true },
    { "source": "/dashboard/master-settings", "destination": "/dashboard/master-settings/tiers", "permanent": true },
    { "source": "/dashboard/logistics-calendar/orders", "destination": "/dashboard/logistics-calendar/all-orders", "permanent": true },
    { "source": "/dashboard/all-orders", "destination": "/dashboard/logistics-calendar/all-orders", "permanent": true },
    { "source": "/dashboard/receivables", "destination": "/dashboard/ar-ap/customers", "permanent": true },
    { "source": "/dashboard/receivables/customers", "destination": "/dashboard/ar-ap/customers", "permanent": true },
    { "source": "/dashboard/receivables/owner", "destination": "/dashboard/ar-ap/owner", "permanent": true },
    { "source": "/dashboard/receivables/staff", "destination": "/dashboard/ar-ap/staff", "permanent": true },
    { "source": "/dashboard/receivables/supplier", "destination": "/dashboard/ar-ap/supplier", "permanent": true },
    { "source": "/dashboard/receivables/assign-account", "destination": "/dashboard/assign-account", "permanent": true },
    { "source": "/dashboard/ar-ap/assign-account", "destination": "/dashboard/assign-account", "permanent": true },
    { "source": "/dashboard/receivables/due-from-owner", "destination": "/dashboard/ar-ap/owner", "permanent": true },
    { "source": "/dashboard/receivables/due-from-staff", "destination": "/dashboard/ar-ap/staff", "permanent": true },
    { "source": "/dashboard/receivables/due-from-supplier", "destination": "/dashboard/ar-ap/supplier", "permanent": true }
  ],
  "rewrites": [
    { "source": "/dashboard/quotations/builder", "destination": "/dashboard/quotations/builder.html" },
    { "source": "/dashboard/warehouse/inspected/in-stock", "destination": "/dashboard/warehouse/inspected-page.html" },
    { "source": "/dashboard/warehouse/inspected/deployed", "destination": "/dashboard/warehouse/inspected-page.html" },
    { "source": "/account-registration", "destination": "/employee-directory-registration" },
    { "source": "/careers/:code", "destination": "/api/career-page?code=:code" },
    { "source": "/dashboard/attendance-leaves/logs", "destination": "/dashboard/attendance-leaves" },
    { "source": "/dashboard/attendance-leaves/leaves", "destination": "/dashboard/attendance-leaves" },
    { "source": "/dashboard/attendance-leaves/settings", "destination": "/dashboard/attendance-leaves" },
    { "source": "/dashboard/events/company", "destination": "/dashboard/events" },
    { "source": "/dashboard/events/holiday", "destination": "/dashboard/events" },
    { "source": "/dashboard/team/tasks", "destination": "/dashboard/team" },
    { "source": "/dashboard/team/milestones", "destination": "/dashboard/team" },
    { "source": "/dashboard/team/projects", "destination": "/dashboard/team" },
    { "source": "/dashboard/business/directions/planning", "destination": "/dashboard/business/directions" },
    { "source": "/dashboard/resources/folders/:code", "destination": "/dashboard/resources" },
    { "source": "/dashboard/CRM", "destination": "/dashboard/sales-crm" },
    { "source": "/dashboard/CRM/customers", "destination": "/dashboard/sales-crm/customers" },
    { "source": "/dashboard/booking-schedules/calendar", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/booking-schedules/all-bookings", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/installers/assignments", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/installers/accounts", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/installers/notes", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/installers/tools", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/inventory/summary", "destination": "/dashboard/inventory" },
    { "source": "/dashboard/inventory/stats", "destination": "/dashboard/inventory" },
    { "source": "/dashboard/master-settings/tiers", "destination": "/dashboard/master-settings" },
    { "source": "/dashboard/master-settings/tenants", "destination": "/dashboard/master-settings" },
    { "source": "/dashboard/master-settings/payment", "destination": "/dashboard/master-settings" },
    { "source": "/dashboard/master-settings/email", "destination": "/dashboard/master-settings" },
    { "source": "/dashboard/hiring/job-post", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/hiring/applicants", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/hiring/contracts", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/hiring/templates", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/hiring/forms", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/warehouse/return", "destination": "/dashboard/warehouse/return" },
    { "source": "/dashboard/sales-goals/goals", "destination": "/dashboard/sales-goals" },
    { "source": "/dashboard/sales-goals/orders", "destination": "/dashboard/sales-goals" },
    { "source": "/dashboard/sales-goals/settings", "destination": "/dashboard/sales-goals" },
    { "source": "/dashboard/sales-goals/commissions", "destination": "/dashboard/sales-commissions" },
    { "source": "/api/track-open", "destination": "/api/send-custom-email" }
  ]
}
