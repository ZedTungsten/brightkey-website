{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    { "source": "/dashboard/booking-schedules", "destination": "/dashboard/booking-schedules/calendar", "permanent": true },
    { "source": "/dashboard/inventory", "destination": "/dashboard/inventory/summary", "permanent": true },
    { "source": "/dashboard/logistics-calendar/orders", "destination": "/dashboard/all-orders", "permanent": true }
  ],
  "rewrites": [
    { "source": "/dashboard/attendance-leaves/logs", "destination": "/dashboard/attendance-leaves" },
    { "source": "/dashboard/attendance-leaves/leaves", "destination": "/dashboard/attendance-leaves" },
    { "source": "/dashboard/attendance-leaves/settings", "destination": "/dashboard/attendance-leaves" },
    { "source": "/dashboard/resources/folders/:code", "destination": "/dashboard/resources" },
    { "source": "/dashboard/CRM", "destination": "/dashboard/sales-crm" },
    { "source": "/dashboard/CRM/customers", "destination": "/dashboard/sales-crm/customers" },
    { "source": "/dashboard/booking-schedules/calendar", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/booking-schedules/all-bookings", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/booking-schedules/installers", "destination": "/dashboard/booking-schedules" },
    { "source": "/dashboard/inventory/summary", "destination": "/dashboard/inventory" },
    { "source": "/dashboard/inventory/stats", "destination": "/dashboard/inventory" },
    { "source": "/dashboard/hiring/job-post", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/hiring/applicants", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/hiring/templates", "destination": "/dashboard/hiring" },
    { "source": "/dashboard/warehouse/return", "destination": "/dashboard/warehouse/return" },
    { "source": "/dashboard/sales-goals/goals", "destination": "/dashboard/sales-goals" },
    { "source": "/dashboard/sales-goals/orders", "destination": "/dashboard/sales-goals" },
    { "source": "/dashboard/sales-goals/settings", "destination": "/dashboard/sales-goals" },
    { "source": "/dashboard/sales-goals/commissions", "destination": "/dashboard/sales-commissions" },
    { "source": "/api/track-open", "destination": "/api/send-custom-email" }
  ]
}
